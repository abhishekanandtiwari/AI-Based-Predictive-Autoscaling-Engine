# Flask Backend Environment Configuration
FLASK_ENV=development
SECRET_KEY=predictive-autoscaling-dev-secret-key-2026
PORT=5000

# SQLite Database (default zero-configuration local path)
DATABASE_URL=sqlite:///instance/autoscaling.db

# Optional Production Database (PostgreSQL example)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/autoscaling_db

# Autoscaling Engine Hyperparameter Defaults
CAPACITY_PER_REPLICA=250
TARGET_CPU=70.0
MIN_REPLICAS=2
MAX_REPLICAS=25
SAFETY_BUFFER=0.15
COST_PER_REPLICA_HOUR=0.05
COOLDOWN_PERIOD=3
